WHATSAPP_API_URL=
# WHATSAPP_API_KEY: API key for authentication with WhatsApp provider
WHATSAPP_API_KEY=
# WHATSAPP_INSTANCE: WhatsApp instance identifier (default: 'default')
WHATSAPP_INSTANCE=default
