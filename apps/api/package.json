{
  "name": "@govmunicipio/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "clean": "rm -rf dist node_modules",
    "seed": "ts-node --project tsconfig.json src/database/seeds/seed.ts",
    "typeorm": "ts-node --project tsconfig.json node_modules/typeorm/cli.js",
    "migration:generate": "npx dotenv-cli -e .env -- ts-node --project tsconfig.json node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:run": "npx dotenv-cli -e .env -- ts-node --project tsconfig.json node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "npx dotenv-cli -e .env -- ts-node --project tsconfig.json node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@govmunicipio/shared": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11",
    "@nestjs/passport": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/typeorm": "^11",
    "bcryptjs": "^2",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "ioredis": "^5",
    "passport": "^0.7",
    "passport-jwt": "^4",
    "pdfkit": "^0.14",
    "pg": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "typeorm": "^0.3",
    "uuid": "^11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@types/bcryptjs": "^2",
    "@types/express": "^4",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/passport-jwt": "^4",
    "@types/pdfkit": "^0.12",
    "@types/uuid": "^10",
    "jest": "^29",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "^5"
  }
}
