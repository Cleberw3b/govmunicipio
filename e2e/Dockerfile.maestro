# ---------------------------------------------------------
# Maestro E2E test runner
# Java 17 + Maestro CLI + Chromium for web testing
# ---------------------------------------------------------
FROM eclipse-temurin:17-jre-alpine

# Install dependencies: bash, curl, chromium for web testing
RUN apk add --no-cache \
    bash \
    curl \
    chromium \
    chromium-chromedriver \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

# Set Chromium environment for headless testing
ENV CHROME_BIN=/usr/bin/chromium-browser
ENV CHROMIUM_FLAGS="--no-sandbox --headless --disable-gpu --disable-dev-shm-usage"

# Install Maestro CLI
RUN curl -fsSL "https://get.maestro.mobile.dev" | bash
ENV PATH="/root/.maestro/bin:${PATH}"

# Copy test flows and scripts
WORKDIR /e2e
COPY e2e/flows ./flows
COPY e2e/.maestro ./.maestro
COPY e2e/scripts ./scripts

# Copy and set up the entrypoint
COPY e2e/scripts/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Results directory
RUN mkdir -p /e2e/results

ENTRYPOINT ["/docker-entrypoint.sh"]
