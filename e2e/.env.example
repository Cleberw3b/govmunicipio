# E2E Testing Configuration
# Copy this file to .env and update with your test environment details

# Base URL for the application
E2E_BASE_URL=http://localhost:3000

# Test timeout (seconds)
E2E_TIMEOUT=300

# Development server port
E2E_DEV_PORT=3000

# Test user credentials (for flows that require authentication)
# Note: These should be for a test account only, never use production credentials
E2E_TEST_USERNAME=test.user
E2E_TEST_PASSWORD=TestPassword123!

# Admin test credentials
E2E_ADMIN_USERNAME=admin@test.com
E2E_ADMIN_PASSWORD=AdminPassword123!

# Super admin test credentials
E2E_SUPER_ADMIN_USERNAME=superadmin@test.com
E2E_SUPER_ADMIN_PASSWORD=SuperAdminPassword123!

# Maestro options
# See: https://maestro.mobile.dev/cli/maestro-cli
MAESTRO_DEBUG=false
MAESTRO_LOG_LEVEL=info
